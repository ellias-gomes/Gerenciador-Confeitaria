# Configurações do Servidor Web / API
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Segurança e Autenticação (troque por segredos fortes em produção)
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# Banco de Dados SQLite
DB_PATH=./backend/data/confeitaria.db

# CORS (use * para acesso via rede local + Android Capacitor, ou liste origens separadas por vírgula)
CORS_ORIGIN=*

# Nível padrão atribuído a novos cadastros públicos (visualizador | atendente)
DEFAULT_REGISTER_ROLE=visualizador

# Usuário administrador inicial (criado automaticamente apenas se não houver admin cadastrado)
ADMIN_NAME=Administradora Confeitaria
ADMIN_EMAIL=admin@confeitaria.local
ADMIN_PASSWORD=troque_esta_senha_123

# Identidade inicial da confeitaria
BAKERY_NAME=Doce Encanto Confeitaria
